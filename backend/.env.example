NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# docs/03 §3.1 — Postgres is the source of truth; docker-compose (infra/docker-compose.yml) gives you
# a matching local instance. Host port 5433, not Postgres's usual 5432 — see that compose file's
# comment for why (a locally-installed native Postgres service is a common 5432 collision).
DATABASE_URL=postgres://teacheros:teacheros@localhost:5433/teacheros

# docs/02 §2.4 — access token short-lived, refresh token long-lived and rotated on use.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# docs/02 §2.5 — cache, rate-limit counters, BullMQ queues (queues wired in a later Phase 4 step).
REDIS_URL=redis://localhost:6379

CORS_ORIGIN=http://localhost:8080
